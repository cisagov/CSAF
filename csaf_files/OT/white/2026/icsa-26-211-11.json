      {
        "category": "summary",
        "text": "Successful exploitation of these vulnerabilities could crash the device being accessed.",
        "title": "Advisory Summary"
      },
      {
        "category": "other",
        "text": "Energy, Water and Wastewater, Critical Manufacturing, Chemical",
