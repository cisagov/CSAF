    {
      "cve": "CVE-2026-84398",
      "cwe": {
        "id": "CWE-258",
        "name": "Empty Password in Configuration File"
      },
      "notes": [
        {
          "category": "summary",
          "text": "CM2507 IP cameras accept an empty password for a privileged account exposed through its ONVIF management service. An attacker with network access to the affected device could access privileged management functions and obtain device, user, media-profile, and stream configuration information.",
