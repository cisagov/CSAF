    {
      "cve": "CVE-2026-113874",
      "cwe": {
        "id": "CWE-863",
        "name": "Incorrect Authorization"
      },
      "notes": [
        {
          "category": "summary",
          "text": "SmileCDR HAPI FHIR allows an untrusted bundle body to replace a partition identity previously established by a trusted source, and does not enforce storage partition entitlement by default. An attacker authorized for one tenant can read from or write to another tenant's partition.",
          "title": "Description"
        },
        {
          "category": "details",
          "title": "SSVC",
          "text": "SSVCv2/E:N/A:N/T:P/2026-10-06T16:14:15Z/"
        }
      ],
      "title": "SmileCDR HAPI FHIR trusted tenant partition override",
      "product_status": {
        "known_affected": [
          "CSAFPID-0001"
        ]
      },
