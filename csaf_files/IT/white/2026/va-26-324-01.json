      {
        "text": "U.S Department of the Interior Unstable Slope Management Program contains multiple vulnerabilities. A combination of the vulnerabilities could allow an attacker to inject SQL commands, create/delete users, retrieve user passwords and bypass authentication.",
        "title": "Risk Evaluation",
        "category": "summary"
      },
      {
        "text": "Fixed on or around 2026-10-19.",
        "title": "Recommended Practices",
        "category": "general"
      },
      {
        "text": "United States",
        "title": "Company Headquarters Location",
        "category": "other"
      }
