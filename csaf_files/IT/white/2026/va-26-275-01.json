    {
      "cve": "CVE-2026-102262",
      "cwe": {
        "id": "CWE-668",
        "name": "Exposure of Resource to Wrong Sphere"
      },
      "notes": [
        {
          "category": "summary",
          "text": "Newell Brands DYMO ID 1.5.1.71 resolves its plugin Modules directory relative to the process working directory. An attacker could store a job file alongside malicious modules / DLL that sets the process working directory to the job file's folder when a victim clicks on the file, resulting in code execution at the victim's privilege level. Fixed in 1.6.0.",
          "title": "Description"
        },
        {
          "category": "details",
          "title": "SSVC",
          "text": "SSVCv2/E:P/A:N/T:T/2026-10-01T14:37:33Z/"
        }
      ],
      "title": "Newell Brands DYMO ID parent directory open to path traversal through improper spheres of control",
      "product_status": {
        "known_affected": [
          "CSAFPID-0001"
        ],
        "fixed": [
