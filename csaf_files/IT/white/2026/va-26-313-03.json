  "vulnerabilities": [
    {
      "cve": "CVE-2026-125297",
      "cwe": {
        "id": "CWE-306",
        "name": "Missing Authentication for Critical Function"
      },
      "notes": [
        {
          "category": "summary",
          "text": "AsiaInfo Business Support System (BSS) 9.2.0 through 9.2.40 accepts unauthenticated requests via the management API '/bss/sysmgnt/api/'. A remote, unauthenticated attacker could provision a new account with administrative privileges or take over existing accounts, and perform other administrative actions. Fixed in 9.2.41.",
          "title": "Description"
        },
        {
          "category": "details",
          "title": "SSVC",
          "text": "SSVCv2/E:N/A:Y/T:T/2026-11-09T20:00:42Z/"
        }
      ],
      "title": "AsiaInfo Business Support System (BSS) Missing Authentication",
      "product_status": {
        "known_affected": [
          "CSAFPID-0005",
          "CSAFPID-0001"
        ],
        "fixed": [
          "CSAFPID-0006",
          "CSAFPID-0002"
        ]
      },
